.DS_Store
dist/*
vendor/gems
vendor/rails
test/coverage
/coverage/
rerun.txt
storage/
node_modules/
public/vite-assets/

# Local-only config (project tracks the templates above; secrets via ENV)
config/master.key
config/credentials/*.key

# Runtime artefacts
/log/*.log
/tmp/*
!/tmp/.keep

# Bundler / local env
.bundle/
.env*.local

# Claude Code runtime
.claude/settings.local.json
.claude/worktrees/
.trackers/

# Ignore key files for decrypting credentials and more.
/config/*.key

# Local-only deploy script (carries kubeconfig paths and namespace names that
# don't apply to other clones; this is an open-source repo).
/bin/deploy

# Vite Ruby
/public/vite*
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local
