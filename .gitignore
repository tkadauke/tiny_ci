.DS_Store
dist/*
vendor/gems
vendor/rails
test/coverage
/coverage/
rerun.txt
storage/

# Local-only config (project tracks the templates above; secrets via ENV)
config/master.key
config/credentials/*.key

# Runtime artefacts
/log/*.log
/tmp/*
!/tmp/.keep

# Bundler / local env
.bundle/
.env*.local

# Claude Code runtime
.claude/settings.local.json
.claude/worktrees/
.trackers/

/app/assets/builds/*
!/app/assets/builds/.keep
