<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".welcome_to_tinyci") %></h1>

  <div class="my-5 prose prose-sm max-w-none text-gray-700">
    <%= render partial: "config_info" %>
  </div>

  <h2 class="font-semibold text-2xl mt-8"><%= t(".database_configuration") %></h2>

  <%= form_with model: @config, scope: :config, url: "/admin/setup", method: :post, local: true, class: "contents" do |f| %>
    <% if @config.error_message %>
      <div class="my-5 py-2 px-3 bg-red-50 text-red-700 rounded-lg">
        <p><%= t(".db_error") %></p>
        <p class="font-mono text-sm mt-1"><%= @config.error_message %></p>
      </div>
    <% end %>

    <div class="my-5">
      <%= f.label :db_user, t(".database_username"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :db_user,
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :db_password, t(".database_password"), class: "block text-sm font-medium text-gray-700" %>
      <p class="text-xs text-gray-500 mt-1"><%= t(".password_description", path: "<code>#{Rails.root}/config/database.yml</code>").html_safe %></p>
      <%= f.password_field :db_password,
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :db_name, t(".database_name"), class: "block text-sm font-medium text-gray-700" %>
      <p class="text-xs text-gray-500 mt-1"><%= t(".database_name_description") %></p>
      <%= f.text_field :db_name,
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :db_host, t(".database_host"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :db_host,
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <%= f.submit t(".save_and_restart"),
          class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  <% end %>
</div>
