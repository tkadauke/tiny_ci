<%= turbo_stream_from "build_#{@build.name}_#{@build.position}" %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve unless @build.finished? %>

<div id="build">
  <%= render :partial => "build" %>
</div>

<div id="bottom_anchor"></div>
<p><%= link_to t('.back_to_builds'), project_plan_builds_path(@project, @plan) %></p>
