<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>TinyCI</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <header class="bg-white border-b border-gray-200">
      <nav class="container mx-auto px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to "TinyCI", root_path, class: "font-bold text-xl text-gray-900 hover:text-blue-600" %>

          <% if logged_in? %>
            <div class="flex items-center gap-4 text-sm">
              <%= link_to t("layouts.all_plans"),  all_plans_path, class: "text-gray-700 hover:text-blue-600" %>
              <%= link_to t("layouts.projects"),   projects_path, class: "text-gray-700 hover:text-blue-600" %>
              <%= link_to t("layouts.users"),      users_path,    class: "text-gray-700 hover:text-blue-600" %>
              <% if current_user.can_configure_slaves? %>
                <%= link_to t("layouts.slaves"),         admin_slaves_path,        class: "text-gray-700 hover:text-blue-600" %>
              <% end %>
              <% if current_user.can_configure_system_variables? %>
                <%= link_to t("layouts.configuration"),  admin_configuration_path, class: "text-gray-700 hover:text-blue-600" %>
              <% end %>
              <%= link_to t("layouts.help"), help_topics_path, class: "text-gray-700 hover:text-blue-600" %>
            </div>
          <% end %>
        </div>

        <div class="flex items-center gap-4 text-sm">
          <% if logged_in? %>
            <span class="text-gray-600">
              <%= t("layouts.user_greeter", user: current_user.login) %>
              <% if current_user.role == "admin" %>
                <span class="ml-1 px-1.5 py-0.5 rounded text-xs bg-blue-100 text-blue-700">admin</span>
              <% end %>
            </span>
            <%= link_to t("layouts.settings"), settings_path, class: "text-gray-700 underline hover:no-underline" %>
            <%= button_to t("layouts.logout"), logout_path, method: :delete,
                  class: "text-gray-700 underline hover:no-underline cursor-pointer",
                  form: { class: "inline" } %>
          <% else %>
            <%= link_to t("layouts.login"),  login_path,    class: "text-gray-700 underline hover:no-underline" %>
            <%= link_to t("layouts.signup"), new_user_path, class: "text-gray-700 underline hover:no-underline" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="container mx-auto mt-10 px-5 pb-16">
      <% if flash[:error] %>
        <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block"><%= flash[:error] %></p>
      <% end %>
      <% if flash[:notice] %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-lg inline-block"><%= flash[:notice] %></p>
      <% end %>

      <%= yield %>
    </main>

    <footer class="container mx-auto px-5 pb-6 text-xs text-gray-400 flex items-center justify-between gap-4">
      <span><%= t("layouts.subtitle") %></span>
      <%= link_to t("layouts.github_project_page"), "https://github.com/tkadauke/tiny_ci",
            target: "_blank", rel: "noopener",
            class: "underline hover:no-underline hover:text-gray-600" %>
    </footer>
  </body>
</html>
