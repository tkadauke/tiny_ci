<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>TinyCI</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <header class="bg-white border-b border-gray-200">
      <nav class="container mx-auto px-5 py-4 flex items-center justify-between">
        <%= link_to "TinyCI", root_path, class: "font-bold text-xl text-gray-900 hover:text-blue-600" %>
        <span class="text-sm text-gray-500"><%= t("layouts.subtitle") %></span>
      </nav>
    </header>

    <main class="container mx-auto mt-10 px-5 pb-16">
      <%= yield %>
    </main>
  </body>
</html>
