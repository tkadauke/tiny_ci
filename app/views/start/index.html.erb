<div
  id="dashboard-root"
  data-logged-in="<%= logged_in? %>"
  data-initial-admin="<%= current_user.initial_admin? %>"
  data-can-create-accounts="<%= current_user.can_create_accounts? %>"
  data-status-icons="<%= json_escape(
    %w[canceled error failure offline pending running stopped stopping success waiting].index_with { |status|
      asset_path("icons/small/#{status}.png")
    }.to_json
  ) %>"
></div>
