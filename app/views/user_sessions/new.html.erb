<h2><%= t('.login') %></h2>

<%= form_with url: login_path, scope: :user_session, local: true do |f| %>
  <p class="form_item">
    <span class="label"><%= f.label :login, t('.user_name') %></span>
    <%= f.text_field :login %>
  </p>
  <p class="form_item">
    <span class="label"><%= f.label :password, t('.password') %></span>
    <%= f.password_field :password %>
  </p>

  <p class="form_item">
    <%= f.check_box :remember_me %><%= f.label :remember_me, t('.remember_me') %>
  </p>

  <%= f.submit t('.login') %>
<% end %>
