<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".login") %></h1>

  <%= form_with url: login_path, scope: :user_session, local: true, class: "contents" do |f| %>
    <div class="my-5">
      <%= f.label :login, t(".user_name"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :login, autofocus: true, autocomplete: "username",
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :password, t(".password"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, autocomplete: "current-password",
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5 flex items-center gap-2 text-sm text-gray-700">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, t(".remember_me") %>
    </div>

    <%= f.submit t(".login"),
          class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  <% end %>
</div>
