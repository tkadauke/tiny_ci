development: &MYSQL_DB
  adapter: trilogy
  encoding: utf8mb4
  username: <%= config.db_user %>
  password: <%= config.db_password %>
  host: <%= config.db_host %>
  database: <%= config.db_name %>
  pool: 5

production:
  <<: *MYSQL_DB

test:
  adapter: sqlite3
  database: storage/test.sqlite3
  pool: 5
  timeout: 5000
